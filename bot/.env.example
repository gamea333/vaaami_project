# Phase 2: enter provider keys locally, never in frontend files or chat.
DEEPGRAM_API_KEY=
GROQ_API_KEY=
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
DEEPGRAM_MODEL=nova-3
GROQ_MODEL=openai/gpt-oss-20b
CARTESIA_MODEL=sonic-3.6

# Choose a private code; enter it in the frontend to authorize a call.
DEMO_ACCESS_CODE=
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Conservative safety limits. Restart after editing. Use one worker, no --reload.
MAX_CALL_SECONDS=120
IDLE_TIMEOUT_SECONDS=30
MAX_CALLS_PER_RUN=10
MAX_RESERVED_SECONDS_PER_RUN=600
MAX_REPLIES_PER_CALL=8
MAX_COMPLETION_TOKENS=512
MAX_TTS_CHARS_PER_CALL=1200
MAX_REPLY_CHARS=300

# Phase 4: run npm run configure:bot --workspace=@vaami/api to configure Windows/WSL uploads.
CALLS_API_BASE_URL=http://127.0.0.1:8787
CALLS_INGEST_TOKEN=


# Optional public STUN for deployed demo connectivity; empty keeps local-only ICE.
STUN_SERVER_URL=
