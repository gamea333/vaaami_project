{
  "name": "@vaami/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-local.mjs",
    "typecheck": "tsc --noEmit",
    "check": "wrangler deploy --dry-run --outdir dist",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "test": "npm run check && node --test test/*.test.mjs",
    "demo:seed": "node scripts/sample-call.mjs",
    "configure:bot": "node scripts/configure-bot.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260928.1",
    "miniflare": "5.20260926.0-alpha",
    "typescript": "7.0.2",
    "wrangler": "4.143.0"
  }
}
