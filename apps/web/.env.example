# Public URL: Vite embeds this in the browser bundle. Never put API keys here.
VITE_API_BASE_URL=http://127.0.0.1:8787
# Public HTTPS tunnel URL for deployed use; local default during development.
VITE_BOT_BASE_URL=http://127.0.0.1:7860

# Optional public STUN URL; never embed TURN credentials in VITE variables.
VITE_STUN_URL=
